{
  "name": "dji-controller-interface",
  "version": "1.0.0",
  "description": "DJI Controller Interface - Electron app replicating DJI controller UI with real-time data",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"webpack --mode development --watch\" \"wait-on dist/main.js && electron .\"",
    "dev:browser": "webpack serve --mode development --config webpack.browser.config.js --open",
    "build": "webpack --mode production",
    "build:browser": "webpack --mode development --config webpack.browser.config.js",
    "start": "electron .",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.0.0",
    "css-loader": "^6.8.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.6.4",
    "postcss": "^8.4.0",
    "postcss-loader": "^7.3.0",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.3.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.13.0"
  },
  "build": {
    "appId": "com.dji.controller.interface",
    "productName": "DJI Controller Interface",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  }
}
